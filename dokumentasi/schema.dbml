// =============================================================================
// DBML — Sistem Informasi Jemaat GKI Syaloom Pasifik Indah
// Database: MySQL — TA_folen | ORM: Prisma
//
// Cara pakai: buka https://dbdiagram.io, salin seluruh isi berkas ini ke editor.
// Semua `id` bertipe varchar (CUID) yang dibuat otomatis oleh Prisma.
// =============================================================================

Project gki_syaloom {
  database_type: 'MySQL'
  Note: 'Sistem Informasi Jemaat GKI Syaloom Pasifik Indah'
}

// --- MASTER DATA ------------------------------------------------------------

Table rayon {
  id varchar [pk]
  nm_rayon varchar [not null, unique, note: 'Nama rayon. Contoh: Galilea, Yerikho, Bethel']

  Note: 'Master data pembagian wilayah rayon jemaat.'
}

Table unsur {
  id varchar [pk]
  nm_unsur varchar [not null, unique, note: 'Contoh: PKB, PW, PAM, Remaja, Tunas Anak']

  Note: 'Master data unsur kategorial gereja.'
}

Table keluarga {
  id varchar [pk]
  no_kk varchar [unique, note: 'Nomor Kartu Keluarga (opsional, unik bila diisi)']
  alamat_blok varchar [not null, note: 'Contoh: G. 16, H. 04, B. 58']
  id_rayon varchar [ref: > rayon.id, note: 'Rayon domisili keluarga (opsional)']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  indexes {
    id_rayon
  }
  Note: 'Kartu keluarga. Alamat & rayon melekat di sini, dibagikan ke semua anggota.'
}

// --- JEMAAT -----------------------------------------------------------------

Table jemaat {
  id varchar [pk]
  id_keluarga varchar [ref: > keluarga.id, note: 'Keluarga tempat bernaung (opsional)']
  nm_lengkap varchar [not null]
  tgl_lahir date [not null]
  jenkel varchar [not null, note: 'L = Laki-laki, P = Perempuan']
  stat_keluarga varchar [not null, note: 'KK, Isteri, Anak, Lain_Lain']
  status varchar [not null, default: 'AKTIF', note: 'AKTIF, PINDAH, MENINGGAL, LAINNYA']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  indexes {
    id_keluarga
  }
  Note: 'Data pribadi anggota jemaat. Alamat & rayon diturunkan dari keluarga.'
}

// --- PELAYANAN --------------------------------------------------------------

Table pendeta {
  id varchar [pk]
  id_jemaat varchar [not null, ref: > jemaat.id]
  gelar varchar [note: 'Contoh: Pdt., Pdt. Emeritus, Vikaris']
  tgl_mulai date [not null]
  tgl_selesai date [note: 'Kosong bila masih menjabat']
  aktif boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  Note: 'Riwayat pelayanan pendeta. Data pribadi diambil dari jemaat.'
}

Table majelis {
  id varchar [pk]
  id_jemaat varchar [not null, ref: > jemaat.id]
  jabatan varchar [not null, note: 'PENATUA, SYAMAS']
  tgl_mulai date [not null]
  tgl_selesai date [note: 'Kosong bila masih menjabat']
  aktif boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  Note: 'Riwayat pelayanan majelis (Penatua & Syamas).'
}

Table badan_pengurus {
  id varchar [pk]
  user_id varchar [unique, ref: - user.id, note: 'Akun akses pengurus (satu-ke-satu, opsional)']
  id_jemaat varchar [not null, ref: > jemaat.id]
  id_unsur varchar [not null, ref: > unsur.id]
  sektor int [note: 'Sektor unsur (umumnya 1-10). Kosong = tingkat unsur']
  jabatan varchar [not null, note: 'Contoh: Ketua, Sekretaris, Bendahara']
  tgl_mulai date [not null]
  tgl_selesai date [note: 'Kosong bila masih menjabat']
  aktif boolean [not null, default: true]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  Note: 'Kepengurusan tiap unsur kategorial.'
}

// --- IBADAH & TURUNANNYA ----------------------------------------------------

Table ibadah {
  id varchar [pk]
  id_jemaat varchar [ref: > jemaat.id, note: 'Tuan rumah / keluarga giliran']
  id_unsur varchar [ref: > unsur.id, note: 'Bila ibadah khusus unsur']
  id_pelayan_firman varchar [ref: > jemaat.id, note: 'Pelayan firman dari data jemaat']
  nm_ibadah varchar [note: 'Nama ibadah eksplisit (opsional)']
  gabungan boolean [not null, default: false]
  sektor int [note: 'Sektor unsur (opsional)']
  tgl date [not null]
  waktu time [not null, note: 'Jam ibadah. Contoh: 05:30, 09:00']
  tempat varchar [note: 'Lokasi aktual bila dipindah']
  alamat_tempat varchar [note: 'Contoh: B. 33, C. 96']
  catatan varchar [note: 'Alasan pemindahan']
  pelayan_firman varchar [note: 'Nama pelayan tamu (teks bebas)']
  liturgos varchar
  pembacaan_alkitab varchar [note: 'Contoh: Markus 16:1-8']
  piket varchar
  p_organ varchar [note: 'Pemain organ/keyboard']
  created_at datetime [not null, default: `now()`]

  Note: 'Jadwal ibadah & agenda pelayanan.'
}

Table kehadiran {
  id varchar [pk]
  id_ibadah varchar [not null, unique, ref: - ibadah.id]
  laki_laki int [not null, default: 0]
  perempuan int [not null, default: 0]
  anak int [not null, default: 0]
  total int [not null, default: 0]

  Note: 'Statistik kehadiran per ibadah (satu-ke-satu dengan ibadah).'
}

Table keuangan {
  id varchar [pk]
  id_ibadah varchar [ref: > ibadah.id, note: 'Ibadah tempat persembahan dikumpulkan (opsional)']
  kategori varchar [not null, note: 'TANGGUK, DIAKONIA, PENGUCAPAN_SYUKUR, PERSEPULUHAN, PEMBANGUNAN_RENOVASI, PENUNJANG_PELAYANAN, INKONVENSIONAL']
  nm_pemberi varchar [note: 'Nama pemberi (opsional)']
  jumlah int [not null, note: 'Nominal dalam Rupiah']
  keterangan text [note: 'Penjelasan syukur (opsional)']
  created_at datetime [not null, default: `now()`]

  Note: 'Penerimaan & persembahan gereja.'
}

// --- INFORMASI & MEDIA ------------------------------------------------------

Table pengumuman {
  id varchar [pk]
  order int [not null, default: 0]
  judul varchar [not null]
  isi text [not null]
  tgl_publish datetime [not null, default: `now()`]
  status boolean [not null, default: true, note: 'true = aktif, false = tidak aktif']

  Note: 'Warta & pengumuman jemaat.'
}

Table renungan {
  id varchar [pk]
  judul varchar [not null]
  bacaan varchar [note: 'Contoh: Matius 28: 1-15']
  kutipan text [note: 'Teks penegas di bawah judul']
  isi text [not null]
  sumber varchar [note: 'Contoh: HT/www.renunganharian.net']
  tgl_publish date [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  Note: 'Renungan harian.'
}

Table galeri_album {
  id varchar [pk]
  order int [not null, default: 0]
  judul varchar [not null, note: 'Contoh: Ibadah Natal 2025']
  keterangan text [note: 'Deskripsi album (opsional)']
  kategori varchar [note: 'Contoh: Ibadah, Baptisan, Natal, Paskah']
  tgl date [note: 'Tanggal kegiatan (opsional)']
  status boolean [not null, default: true, note: 'true = tampil, false = disembunyikan']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  Note: 'Album/kegiatan yang menampung banyak foto.'
}

Table galeri_foto {
  id varchar [pk]
  id_album varchar [not null, ref: > galeri_album.id]
  url varchar [not null, note: 'Path/URL berkas gambar']
  caption varchar [note: 'Keterangan per foto (opsional)']
  order int [not null, default: 0]
  created_at datetime [not null, default: `now()`]

  Note: 'Foto milik sebuah album. Terhapus bila albumnya dihapus (cascade).'
}

// --- AKUN, HAK AKSES & AUDIT ------------------------------------------------

Table user {
  id varchar [pk]
  username varchar [not null, unique]
  password varchar [not null, note: 'Tersimpan ter-hash']
  role varchar [not null, note: 'ADMIN, KETUA_UNSUR, KOORDINATOR_UNSUR']
  created_at datetime [not null, default: `now()`]

  Note: 'Akun akses sistem (autentikasi & otorisasi).'
}

Table role_permission {
  id varchar [pk]
  role varchar [not null, note: 'KETUA_UNSUR, KOORDINATOR_UNSUR']
  resource varchar [not null, note: 'Kunci modul. Contoh: jemaat, agenda, keuangan']
  can_view boolean [not null, default: false]
  can_create boolean [not null, default: false]
  can_update boolean [not null, default: false]
  can_delete boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null]

  indexes {
    (role, resource) [unique]
    role
  }
  Note: 'Hak akses per peran non-admin. ADMIN selalu berakses penuh (tidak disimpan).'
}

Table log_aktivitas {
  id varchar [pk]
  id_user varchar [ref: > user.id, note: 'Pelaku aksi (SetNull bila user dihapus)']
  username varchar [not null, note: 'Snapshot username saat aksi']
  role varchar [note: 'Snapshot peran pelaku']
  aksi varchar [not null, note: 'CREATE, UPDATE, DELETE']
  entitas varchar [not null, note: 'Model terkait. Contoh: Ibadah, Pengumuman']
  id_entitas varchar [note: 'id baris yang terpengaruh']
  ringkasan varchar [note: 'Label ringkas. Contoh: judul/nama ibadah']
  detail text [note: 'Cuplikan data (JSON) opsional']
  ip varchar [note: 'Alamat IP pelaku']
  created_at datetime [not null, default: `now()`]

  indexes {
    created_at
    (entitas, id_entitas)
    id_user
  }
  Note: 'Jejak audit: siapa melakukan aksi apa terhadap data apa dan kapan.'
}
